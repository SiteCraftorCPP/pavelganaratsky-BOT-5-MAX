# Токен бота MAX: business.max.ru → Чат-боты → Интеграция → Получить токен
MAX_BOT_TOKEN=

# Несколько админов: числовые user_id через запятую или ; (пробелы ок; не строка из букв/символов)
# Админ должен хотя бы раз написать боту или нажать «Старт», чтобы сохранился chat_id для доставки.
ADMIN_IDS=111111111,222222222

# Базовый URL API (с 19.07.2026 — только platform-api2.max.ru, см. https://dev.max.ru/docs-api )
MAX_API_BASE=https://platform-api2.max.ru

# TLS: 1 — certifi + certs/russian_trusted_bundle.pem (НУЦ Минцифры), 0 — отключить проверку, либо путь к своему .pem
MAX_SSL_VERIFY=1

# При старте удалить webhook-подписки, чтобы работал Long Polling (GET /updates)
MAX_UNSUBSCRIBE_WEBHOOK_ON_START=1
